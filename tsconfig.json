{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@languageIcon/*": ["assets/img/languageIcon/*"],
      "@weatherLogo/*": ["assets/img/weatherLogo/*"],
      "@img/*": ["assets/img/*"],
      "@components/*": ["components/*"],
      "@constants/*": ["constants/*"],
      "@hoocks/*": ["hoocks/*"],
      "@type/*": ["types/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src"]
}
